<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions are declared only in the `plus` flavor, for SMB file sharing.
         The `core` flavor never requests them, so it is verifiably network-free. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Preparing the thumbnails of a share runs as a foreground service with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".NetworkBrowseActivity"
            android:exported="false"
            android:label="@string/network_browse_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.LiteGallery.Pack.FirstLight.NoActionBar" />

        <activity
            android:name=".NetworkTrashActivity"
            android:exported="false"
            android:label="@string/trash_bin_title"
            android:parentActivityName=".NetworkBrowseActivity"
            android:theme="@style/Theme.LiteGallery.Pack.FirstLight.NoActionBar" />

        <service
            android:name=".ThumbnailPrepareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
