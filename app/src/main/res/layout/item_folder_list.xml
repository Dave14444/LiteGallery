<?xml version="1.0" encoding="utf-8"?>
<!-- A folder as a row of the list view: small cover, name, number of pictures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbnailImageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/colorSurfaceVariant"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
        tools:src="@drawable/ic_folder" />

    <TextView
        android:id="@+id/folderNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Urlaub 2024" />

    <TextView
        android:id="@+id/countChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_count_chip"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary"
        tools:text="109" />

</LinearLayout>
