new file mode 100644
index 0000000..72f236a
--- /dev/null
+++ b/app/src/main/java/org/iurl/litegallery/DestinationPicker.kt
@@ -0,0 +1,186 @@
+package org.iurl.litegallery
+
+import android.app.AlertDialog
+import android.content.Context
+import android.content.DialogInterface
+import android.os.Environment
+import android.widget.ArrayAdapter
+import android.widget.EditText
+import android.widget.ListView
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import androidx.lifecycle.lifecycleScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.File
+
+/**
+ * Folder browser for choosing where files are copied or moved to: the phone's storage or any
+ * destination offered by a [MediaSource] (e.g. the saved network shares). New folders can be
+ * created on the spot.
+ */
+object DestinationPicker {
+
+    private const val PREFS = "file_operations"
+    private const val KEY_LAST_DESTINATION = "last_destination"
+
+    /** [path] is the folder this row leads to; null means the list of storage locations. */
+    private data class Row(val label: String, val path: String?)
+
+    fun show(
+        activity: AppCompatActivity,
+        mode: FileTransfer.Mode,
+        onPicked: (String) -> Unit
+    ) {
+        val prefs = activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val phoneRoot = Environment.getExternalStorageDirectory().absolutePath
+
+        val listView = ListView(activity)
+        val rowAdapter = ArrayAdapter<String>(activity, android.R.layout.simple_list_item_1)
+        listView.adapter = rowAdapter
+        var rows: List<Row> = emptyList()
+        var currentPath: String? = null
+
+        val dialog = AlertDialog.Builder(activity)
+            .setTitle(R.string.file_op_choose_destination)
+            .setView(listView)
+            .setPositiveButton(
+                if (mode == FileTransfer.Mode.COPY) R.string.file_op_copy_here else R.string.file_op_move_here,
+                null
+            )
+            .setNeutralButton(R.string.file_op_new_folder, null)
+            .setNegativeButton(R.string.cancel, null)
+            .create()
+        dialog.show()
+
+        fun showRows(newRows: List<Row>) {
+            rows = newRows
+            rowAdapter.clear()
+            rowAdapter.addAll(newRows.map { it.label })
+            rowAdapter.notifyDataSetChanged()
+        }
+
+        fun titleFor(path: String?): String = when {
+            path == null -> activity.getString(R.string.file_op_choose_destination)
+            path.contains("://") -> path.substringAfter("://")
+            path.startsWith(phoneRoot) ->
+                activity.getString(R.string.file_op_phone_storage) + path.removePrefix(phoneRoot)
+            else -> path
+        }
+
+        // path == null: show the list of storage locations
+        fun load(path: String?) {
+            currentPath = path
+            dialog.setTitle(titleFor(path))
+            dialog.getButton(DialogInterface.BUTTON_POSITIVE).isEnabled = path != null
+            dialog.getButton(DialogInterface.BUTTON_NEUTRAL).isEnabled = path != null
+
+            activity.lifecycleScope.launch {
+                try {
+                    val loaded = withContext(Dispatchers.IO) {
+                        buildRows(activity.applicationContext, path, phoneRoot)
+                    }
+                    showRows(loaded)
+                } catch (e: Exception) {
+                    android.util.Log.e("DestinationPicker", "Could not open $path", e)
+                    Toast.makeText(activity, R.string.file_op_folder_failed, Toast.LENGTH_LONG).show()
+                    // Always offer a way out, e.g. when the last used folder is not reachable.
+                    showRows(listOf(Row("..", null)))
+                }
+            }
+        }
+
+        fun createFolder() {
+            val parent = currentPath ?: return
+            val input = EditText(activity).apply {
+                setSingleLine()
+                setHint(R.string.file_op_new_folder_hint)
+            }
+            AlertDialog.Builder(activity)
+                .setTitle(R.string.file_op_new_folder)
+                .setView(input)
+                .setPositiveButton(R.string.file_op_create) { _, _ ->
+                    val name = input.text.toString().trim()
+                    if (name.isEmpty() || name.contains('/') || name.contains('\\')) {
+                        Toast.makeText(activity, R.string.file_op_folder_create_failed, Toast.LENGTH_LONG).show()
+                        return@setPositiveButton
+                    }
+                    activity.lifecycleScope.launch {
+                        val created = withContext(Dispatchers.IO) {
+                            createFolderIn(activity.applicationContext, parent, name)
+                        }
+                        if (created != null) {
+                            load(created)
+                        } else {
+                            Toast.makeText(activity, R.string.file_op_folder_create_failed, Toast.LENGTH_LONG).show()
+                        }
+                    }
+                }
+                .setNegativeButton(R.string.cancel, null)
+                .show()
+        }
+
+        dialog.getButton(DialogInterface.BUTTON_POSITIVE).setOnClickListener {
+            val path = currentPath
+            if (path != null) {
+                prefs.edit().putString(KEY_LAST_DESTINATION, path).apply()
+                dialog.dismiss()
+                onPicked(path)
+            }
+        }
+        dialog.getButton(DialogInterface.BUTTON_NEUTRAL).setOnClickListener {
+            createFolder()
+        }
+        listView.setOnItemClickListener { _, _, position, _ ->
+            val target = rows.getOrNull(position)?.path
+            // Browsing the phone's storage needs all-files access.
+            if (target != null && FileTransfer.isLocalPath(target) && !StorageAccess.ensure(activity)) {
+                return@setOnItemClickListener
+            }
+            load(target)
+        }
+
+        val last = prefs.getString(KEY_LAST_DESTINATION, null)
+        val usable = last != null && (
+            !FileTransfer.isLocalPath(last) ||
+                (StorageAccess.hasAllFilesAccess() && File(last).isDirectory)
+            )
+        load(if (usable) last else null)
+    }
+
+    private fun buildRows(context: Context, path: String?, phoneRoot: String): List<Row> {
+        if (path == null) {
+            val roots = mutableListOf(Row(context.getString(R.string.file_op_phone_storage), phoneRoot))
+            MediaSourceRegistry.all().forEach { source ->
+                source.destinationRoots(context).forEach { roots.add(Row(it.name, it.path)) }
+            }
+            return roots
+        }
+
+        val source = MediaSourceRegistry.forPath(path)
+        val parent: String?
+        val folders: List<FolderEntry>
+        if (source == null) {
+            parent = if (path == phoneRoot) null else File(path).parent
+            folders = File(path).listFiles { file -> file.isDirectory && !file.name.startsWith(".") }
+                ?.map { FolderEntry(it.name, it.absolutePath) }
+                ?: emptyList()
+        } else {
+            parent = source.parentFolder(path)
+            folders = source.listSubFolders(context, path)
+        }
+
+        return listOf(Row("..", parent)) +
+            folders.sortedBy { it.name.lowercase() }.map { Row(it.name + "/", it.path) }
+    }
+
+    /** Creates folder [name] in [parent] and returns its path, or null. */
+    private fun createFolderIn(context: Context, parent: String, name: String): String? {
+        val source = MediaSourceRegistry.forPath(parent)
+        if (source != null) return source.createFolder(context, parent, name)
+
+        val folder = File(parent, name)
+        return if (folder.isDirectory || folder.mkdirs()) folder.absolutePath else null
+    }
+}
diff --git a/app/src/main/java/org/iurl/litegallery/FileOperationDialogs.kt b/app/src/main/java/org/iurl/litegallery/FileOperationDialogs.kt
new file mode 100644
index 0000000..5516f5a
--- /dev/null
+++ b/app/src/main/java/org/iurl/litegallery/FileOperationDialogs.kt
@@ -0,0 +1,66 @@
+package org.iurl.litegallery
+
+import android.app.AlertDialog
+import android.content.Context
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** Progress dialog and result message for long-running file operations. */
+object FileOperationDialogs {
+
+    // The operation keeps running (and reports back) even if the screen is recreated meanwhile.
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
+
+    /**
+     * Runs [work] on a background thread while a progress dialog is shown, then reports the
+     * result. [onDone] is only called while [activity] is still alive.
+     */
+    fun runWithProgress(
+        activity: AppCompatActivity,
+        titleRes: Int,
+        total: Int,
+        work: (onProgress: (done: Int, total: Int) -> Unit) -> FileTransfer.Result,
+        onDone: (FileTransfer.Result) -> Unit
+    ) {
+        val appContext = activity.applicationContext
+        val dialog = AlertDialog.Builder(activity)
+            .setTitle(titleRes)
+            .setMessage("0 / $total")
+            .setCancelable(false)
+            .create()
+        dialog.show()
+
+        scope.launch {
+            val result = withContext(Dispatchers.IO) {
+                work { done, all ->
+                    activity.runOnUiThread {
+                        if (dialog.isShowing) dialog.setMessage("$done / $all")
+                    }
+                }
+            }
+            val alive = !activity.isFinishing && !activity.isDestroyed
+            if (alive) {
+                try {
+                    dialog.dismiss()
+                } catch (_: Exception) {
+                }
+            }
+            showResult(appContext, result)
+            if (alive) onDone(result)
+        }
+    }
+
+    private fun showResult(context: Context, result: FileTransfer.Result) {
+        val message = if (result.failed == 0) {
+            context.getString(R.string.file_op_done, result.done)
+        } else {
+            context.getString(R.string.file_op_partial, result.done, result.failed)
+        }
+        Toast.makeText(context, message, Toast.LENGTH_LONG).show()
+    }
+}
diff --git a/app/src/main/java/org/iurl/litegallery/FileTransfer.kt b/app/src/main/java/org/iurl/litegallery/FileTransfer.kt
new file mode 100644
index 0000000..572c737
--- /dev/null
+++ b/app/src/main/java/org/iurl/litegallery/FileTransfer.kt
@@ -0,0 +1,284 @@
+package org.iurl.litegallery
+
+import android.content.ContentValues
+import android.content.Context
+import android.media.MediaScannerConnection
+import android.net.Uri
+import android.os.Build
+import android.provider.MediaStore
+import java.io.File
+import java.io.FileInputStream
+import java.io.InputStream
+
+/**
+ * Copy, move and delete for media files, on the phone and on any [MediaSource] that supports
+ * file operations (e.g. a network share). All functions block: call them off the main thread.
+ *
+ * Paths without a registered [MediaSource] are local file paths.
+ */
+object FileTransfer {
+
+    enum class Mode { COPY, MOVE }
+
+    class Result(
+        /** Number of files processed successfully. */
+        val done: Int,
+        val failed: Int,
+        /** New files that were created (local paths or remote URLs). */
+        val createdPaths: List<String>,
+        /** Source files that no longer exist at their old location. */
+        val removedPaths: List<String>
+    )
+
+    private const val BUFFER_SIZE = 256 * 1024
+
+    // ---------------------------------------------------------------- copy / move
+
+    fun transfer(
+        context: Context,
+        sourcePaths: List<String>,
+        destFolder: String,
+        mode: Mode,
+        onProgress: (done: Int, total: Int) -> Unit
+    ): Result {
+        val destSource = MediaSourceRegistry.forPath(destFolder)
+        val created = mutableListOf<String>()
+        val removed = mutableListOf<String>()
+        var done = 0
+        var failed = 0
+
+        sourcePaths.forEachIndexed { index, sourcePath ->
+            val ok = try {
+                transferOne(context, sourcePath, destFolder, destSource, mode, created, removed)
+            } catch (e: Exception) {
+                android.util.Log.e("FileTransfer", "Transfer failed: $sourcePath", e)
+                false
+            }
+            if (ok) done++ else failed++
+            onProgress(index + 1, sourcePaths.size)
+        }
+
+        scanLocalPaths(context, created + removed)
+        return Result(done, failed, created, removed)
+    }
+
+    private fun transferOne(
+        context: Context,
+        sourcePath: String,
+        destFolder: String,
+        destSource: MediaSource?,
+        mode: Mode,
+        created: MutableList<String>,
+        removed: MutableList<String>
+    ): Boolean {
+        val sourceSource = MediaSourceRegistry.forPath(sourcePath)
+        val name = fileNameOf(sourcePath)
+
+        // Moving a file into the folder it is already in: nothing to do.
+        if (mode == Mode.MOVE && parentOf(sourcePath, sourceSource) == destFolder.trimEnd('/')) {
+            return true
+        }
+
+        // Moves that need no data transfer: rename on the phone / on the same share.
+        if (mode == Mode.MOVE) {
+            val moved = if (sourceSource == null && destSource == null) {
+                moveLocal(sourcePath, destFolder)
+            } else if (sourceSource != null && sourceSource === destSource) {
+                sourceSource.moveWithin(context, sourcePath, destFolder, name)
+            } else {
+                null
+            }
+            if (moved != null) {
+                created.add(moved)
+                removed.add(sourcePath)
+                return true
+            }
+        }
+
+        // Copy the data, keeping the original modification time.
+        val lastModified = if (sourceSource == null) {
+            File(sourcePath).lastModified()
+        } else {
+            sourceSource.lastModified(context, sourcePath)
+        }
+        val input: InputStream = if (sourceSource == null) {
+            FileInputStream(sourcePath)
+        } else {
+            sourceSource.openInput(context, sourcePath)
+        }
+        val newPath = input.use {
+            if (destSource == null) {
+                writeLocal(File(destFolder), name, it, lastModified)
+            } else {
+                destSource.writeNew(context, destFolder, name, it, lastModified)
+            }
+        } ?: return false
+        created.add(newPath)
+
+        if (mode == Mode.MOVE) {
+            val deleted = if (sourceSource == null) {
+                deleteLocalFile(File(sourcePath))
+            } else {
+                sourceSource.deleteFile(context, sourcePath)
+            }
+            if (!deleted) return false
+            removed.add(sourcePath)
+        }
+        return true
+    }
+
+    // ---------------------------------------------------------------- delete
+
+    /**
+     * Deletes [items]. Local files go to the trash when [moveToTrash] is set (like in the
+     * viewer); files on a [MediaSource] are always deleted for good.
+     */
+    fun delete(
+        context: Context,
+        items: List<MediaItemSkeleton>,
+        moveToTrash: Boolean,
+        onProgress: (done: Int, total: Int) -> Unit
+    ): Result {
+        val removed = mutableListOf<String>()
+        var done = 0
+        var failed = 0
+
+        items.forEachIndexed { index, item ->
+            val ok = try {
+                deleteOne(context, item, moveToTrash)
+            } catch (e: Exception) {
+                android.util.Log.e("FileTransfer", "Delete failed: ${item.path}", e)
+                false
+            }
+            if (ok) {
+                done++
+                removed.add(item.path)
+            } else {
+                failed++
+            }
+            onProgress(index + 1, items.size)
+        }
+
+        scanLocalPaths(context, removed)
+        return Result(done, failed, emptyList(), removed)
+    }
+
+    private fun deleteOne(context: Context, item: MediaItemSkeleton, moveToTrash: Boolean): Boolean {
+        val source = MediaSourceRegistry.forPath(item.path)
+        if (source != null) return source.deleteFile(context, item.path)
+
+        val file = File(item.path)
+        if (!file.exists()) return true
+        if (moveToTrash) return trashLocal(context, item, file)
+
+        if (file.delete()) return true
+        // Fall back to MediaStore (e.g. files owned by another app).
+        val uri = item.thumbnailModel() as? Uri ?: return false
+        return try {
+            context.contentResolver.delete(uri, null, null) > 0
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    private fun trashLocal(context: Context, item: MediaItemSkeleton, file: File): Boolean {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            val uri = item.thumbnailModel() as? Uri
+            if (uri != null) {
+                try {
+                    val values = ContentValues().apply {
+                        put(MediaStore.MediaColumns.IS_TRASHED, 1)
+                    }
+                    if (context.contentResolver.update(uri, values, null, null) > 0) return true
+                } catch (_: Exception) {
+                    // Fall through to the app trash.
+                }
+            }
+        }
+        return moveToAppTrash(context, file)
+    }
+
+    private fun moveToAppTrash(context: Context, file: File): Boolean {
+        val parent = file.parentFile ?: return false
+        val originalName = file.name
+
+        for (index in 0..9999) {
+            val candidateName = if (index == 0) {
+                "${TrashBinStore.TRASH_FILE_PREFIX}$originalName"
+            } else {
+                "${TrashBinStore.TRASH_FILE_PREFIX}$index-$originalName"
+            }
+            val candidate = File(parent, candidateName)
+            if (candidate.exists()) continue
+            if (!file.renameTo(candidate)) return false
+            TrashBinStore.rememberTrashedFile(
+                context = context,
+                trashedUri = Uri.fromFile(candidate),
+                originalUri = Uri.fromFile(file),
+                originalName = originalName,
+                originalPathHint = file.absolutePath
+            )
+            return true
+        }
+        return false
+    }
+
+    // ---------------------------------------------------------------- local helpers
+
+    fun isLocalPath(path: String): Boolean = MediaSourceRegistry.forPath(path) == null
+
+    private fun fileNameOf(path: String): String =
+        path.trimEnd('/').substringAfterLast('/')
+
+    private fun parentOf(path: String, source: MediaSource?): String? =
+        if (source == null) File(path).parent else source.parentFolder(path)?.trimEnd('/')
+
+    private fun moveLocal(sourcePath: String, destFolder: String): String? {
+        val source = File(sourcePath)
+        val dir = File(destFolder)
+        if (!dir.isDirectory && !dir.mkdirs()) return null
+        val target = uniqueFile(dir, source.name)
+        // renameTo fails across storage volumes; the caller then copies instead.
+        return if (source.renameTo(target)) target.absolutePath else null
+    }
+
+    private fun writeLocal(dir: File, name: String, input: InputStream, lastModified: Long): String? {
+        if (!dir.isDirectory && !dir.mkdirs()) return null
+        val target = uniqueFile(dir, name)
+        return try {
+            target.outputStream().use { output ->
+                input.copyTo(output, BUFFER_SIZE)
+            }
+            if (lastModified > 0L) target.setLastModified(lastModified)
+            target.absolutePath
+        } catch (e: Exception) {
+            android.util.Log.e("FileTransfer", "Could not write ${target.path}", e)
+            target.delete()
+            null
+        }
+    }
+
+    /** [name] in [dir], or "name (1).ext", "name (2).ext", ... if it already exists. */
+    private fun uniqueFile(dir: File, name: String): File {
+        var candidate = File(dir, name)
+        if (!candidate.exists()) return candidate
+
+        val base = name.substringBeforeLast('.', name)
+        val extension = name.substringAfterLast('.', "")
+        for (i in 1..9999) {
+            val candidateName = if (extension.isEmpty()) "$base ($i)" else "$base ($i).$extension"
+            candidate = File(dir, candidateName)
+            if (!candidate.exists()) return candidate
+        }
+        return candidate
+    }
+
+    private fun deleteLocalFile(file: File): Boolean = file.delete() || !file.exists()
+
+    /** Tells MediaStore about new / removed local files. */
+    private fun scanLocalPaths(context: Context, paths: List<String>) {
+        val local = paths.filter { isLocalPath(it) }.distinct()
+        if (local.isEmpty()) return
+        MediaScannerConnection.scanFile(context, local.toTypedArray(), null, null)
+    }
+}
